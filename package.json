{
  "name": "todotoday",
  "productName": "TodoToday",
  "version": "1.1.1",
  "description": "A simple, beautiful desktop todo list app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "app": "vite build && electron .",
    "dist": "npm run build && electron-builder --mac --arm64 -c.directories.output=\"$HOME/Library/Caches/todotoday-build\"",
    "dist:dir": "npm run build && electron-builder --mac --dir --arm64 -c.directories.output=\"$HOME/Library/Caches/todotoday-build\""
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.todotoday.app",
    "productName": "TodoToday",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "assets/icons/icon.icns"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "assets/icons/icon.png"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.0"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
